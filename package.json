{
  "name": "qibermail",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.1",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "check": "bun run typecheck && bun run lint && bun test && bun run build",
    "deploy": "bun run build && bun run db:migrate:remote && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "icons": "bun scripts/generate-icons.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@lingui/core": "latest",
    "@lingui/react": "latest",
    "@radix-ui/react-slot": "latest",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.7.2",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "latest",
    "mimetext": "^3.0.28",
    "nanoid": "^6.0.1",
    "postal-mime": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "latest",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "latest",
    "web-push": "^3.6.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.26.0",
    "@lingui/cli": "latest",
    "@lingui/vite-plugin": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/bun": "latest",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.20.0",
    "prettier": "^3.8.1",
    "shadcn": "latest",
    "sharp": "^0.35.4",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.70.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "workerd"
  ]
}

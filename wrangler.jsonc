{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qibermail",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "keep_vars": true,
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "qibermail" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "REALTIME", "class_name": "RealtimeHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RealtimeHub"] }
  ],
  "workflows": [
    {
      "name": "qibermail-database-backup",
      "binding": "DATABASE_BACKUP_WORKFLOW",
      "class_name": "DatabaseBackupWorkflow"
    }
  ],
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "AI_SPAM_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "ai": { "binding": "AI", "remote": true },
  "send_email": [
    { "name": "EMAIL", "remote": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qibermail",
      "database_id": "8ba9978a-c333-4497-9d19-00b580acab93",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "qibermail-raw",
      "preview_bucket_name": "qibermail-raw"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "INBOUND_QUEUE", "queue": "qibermail-inbound" },
      { "binding": "OUTBOUND_QUEUE", "queue": "qibermail-outbound" }
    ],
    "consumers": [
      { "queue": "qibermail-inbound", "max_batch_size": 5, "max_retries": 3, "dead_letter_queue": "qibermail-dlq" },
      { "queue": "qibermail-outbound", "max_batch_size": 5, "max_retries": 3, "dead_letter_queue": "qibermail-dlq" },
      { "queue": "qibermail-email-events", "max_batch_size": 10, "max_retries": 3, "dead_letter_queue": "qibermail-dlq" },
      // Whatever still failed after its retries; recorded for the admin section instead of being dropped.
      { "queue": "qibermail-dlq", "max_batch_size": 10, "max_retries": 3 }
    ]
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["* * * * *", "0 2 * * *"] },
  "upload_source_maps": true
}
